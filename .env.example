APP_NAME="Bulk Certificate Generator API"
APP_ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database connection URL (PostgreSQL default)
# Format: postgresql://username:password@localhost:5432/database_name
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certificate_db"

# Storage configuration
STORAGE_DIR="storage/certificates"

# System Limits
MAX_RECIPIENTS_PER_JOB=1000
